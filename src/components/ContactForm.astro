---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.form;

const MAX_MESSAGE_LENGTH = 1000;

// Handed to the client script below via define:vars — inline scripts can't read
// component frontmatter on their own.
const i18n = {
  tipos: f.tipos,
  validation: f.validation,
  status: f.status,
  errors: f.errors,
  submit: f.submit,
  submitting: f.submitting,
};
---

<div class="contact-form-wrap">
  <form id="contact-form" class="contact-form" novalidate>
    <div class="form-row">
      <div class="field">
        <label for="nombre">{f.name}</label>
        <input id="nombre" name="nombre" type="text" autocomplete="name" required />
        <span class="field-error" id="nombre-error" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for="email">{f.email}</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <span class="field-error" id="email-error" aria-live="polite"></span>
      </div>
    </div>

    <div class="field">
      <label for="tipo">{f.reason}</label>
      <select id="tipo" name="tipo" required>
        <option value="" disabled selected>{f.selectOption}</option>
        <option value="trabajo">{f.tipoTrabajo}</option>
        <option value="freelance">{f.tipoFreelance}</option>
        <option value="networking">{f.tipoNetworking}</option>
      </select>
      <span class="field-error" id="tipo-error" aria-live="polite"></span>
    </div>

    <div class="field" id="empresa-field" hidden>
      <label for="empresa" id="empresa-label">{f.company}</label>
      <input id="empresa" name="empresa" type="text" />
    </div>

    <div class="field">
      <label for="mensaje">{f.message}</label>
      <textarea id="mensaje" name="mensaje" rows="5" maxlength={MAX_MESSAGE_LENGTH} required></textarea>
      <p class="mensaje-hint" id="mensaje-hint" hidden></p>
      <div class="mensaje-meta">
        <span class="field-error" id="mensaje-error" aria-live="polite"></span>
        <span class="char-counter" id="char-counter" aria-live="polite">0 / {MAX_MESSAGE_LENGTH}</span>
      </div>
    </div>

    <button type="submit" id="submit-btn" class="btn primary form-submit">{f.submit}</button>

    <div id="form-status" class="form-status" role="alert" hidden></div>
  </form>
</div>

<style>
  .contact-form-wrap {
    max-width: 32rem;
    margin: 48px auto 0;
    padding: clamp(20px, 4vw, 40px);
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .form-row { grid-template-columns: 1fr 1fr; }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--fg);
    background: var(--bg-elev);
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.15s;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--fg-dim);
  }

  .field select { cursor: pointer; }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .field input.invalid,
  .field select.invalid,
  .field textarea.invalid {
    border-color: #e5484d;
  }

  .field textarea { resize: vertical; }

  .field-error {
    font-size: 12px;
    color: #e5484d;
    min-height: 14px;
  }

  .mensaje-hint {
    font-size: 12px;
    color: var(--fg-mute);
    margin: 0;
  }

  .mensaje-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .char-counter {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    white-space: nowrap;
  }

  .form-submit {
    align-self: flex-start;
    cursor: pointer;
    padding: 12px 28px;
    font-size: 14px;
  }
  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .form-submit {
      align-self: stretch;
      justify-content: center;
    }
  }

  .form-status {
    border-radius: 6px;
    padding: 14px 16px;
    font-size: 14px;
  }
  .form-status .status-title {
    font-weight: 600;
    margin: 0 0 2px;
  }
  .form-status .status-subtitle {
    margin: 0;
    color: var(--fg-mute);
  }
  .form-status.success {
    background: color-mix(in oklch, #30a46c 15%, transparent);
    border: 1px solid #30a46c;
    color: #30a46c;
  }
  .form-status.success .status-subtitle { color: var(--fg-mute); }
  .form-status.error {
    background: color-mix(in oklch, #e5484d 15%, transparent);
    border: 1px solid #e5484d;
    color: #e5484d;
  }
</style>

<script define:vars={{ i18n, lang, MAX_MESSAGE_LENGTH }}>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const fmt = (template, params) =>
    template.replace(/\{(\w+)\}/g, (m, key) => (key in params ? String(params[key]) : m));

  const form = document.getElementById('contact-form');
  const nombreInput = document.getElementById('nombre');
  const emailInput = document.getElementById('email');
  const tipoSelect = document.getElementById('tipo');
  const empresaField = document.getElementById('empresa-field');
  const empresaLabel = document.getElementById('empresa-label');
  const empresaInput = document.getElementById('empresa');
  const mensajeTextarea = document.getElementById('mensaje');
  const mensajeHint = document.getElementById('mensaje-hint');
  const charCounter = document.getElementById('char-counter');
  const submitBtn = document.getElementById('submit-btn');
  const formStatus = document.getElementById('form-status');

  const errors = {
    nombre: document.getElementById('nombre-error'),
    email: document.getElementById('email-error'),
    tipo: document.getElementById('tipo-error'),
    mensaje: document.getElementById('mensaje-error'),
  };

  function setFieldError(input, errorEl, message) {
    input.classList.toggle('invalid', Boolean(message));
    errorEl.textContent = message;
  }

  function clearErrors() {
    setFieldError(nombreInput, errors.nombre, '');
    setFieldError(emailInput, errors.email, '');
    setFieldError(tipoSelect, errors.tipo, '');
    setFieldError(mensajeTextarea, errors.mensaje, '');
  }

  function validateClientSide() {
    clearErrors();
    let valid = true;
    const v = i18n.validation;

    if (!nombreInput.value.trim()) {
      setFieldError(nombreInput, errors.nombre, v.nameRequired);
      valid = false;
    }

    if (!emailInput.value.trim()) {
      setFieldError(emailInput, errors.email, v.emailRequired);
      valid = false;
    } else if (!EMAIL_RE.test(emailInput.value.trim())) {
      setFieldError(emailInput, errors.email, v.emailInvalid);
      valid = false;
    }

    if (!tipoSelect.value) {
      setFieldError(tipoSelect, errors.tipo, v.tipoRequired);
      valid = false;
    }

    if (!mensajeTextarea.value.trim()) {
      setFieldError(mensajeTextarea, errors.mensaje, v.messageRequired);
      valid = false;
    } else if (mensajeTextarea.value.length > MAX_MESSAGE_LENGTH) {
      setFieldError(
        mensajeTextarea,
        errors.mensaje,
        fmt(v.messageTooLong, { max: MAX_MESSAGE_LENGTH })
      );
      valid = false;
    }

    return valid;
  }

  tipoSelect.addEventListener('change', () => {
    const tipo = tipoSelect.value;
    if (!tipo) {
      empresaField.hidden = true;
      mensajeHint.hidden = true;
      return;
    }
    const config = i18n.tipos[tipo];
    empresaField.hidden = false;
    empresaLabel.textContent = config.companyLabel;
    empresaInput.placeholder = config.companyPlaceholder;
    mensajeHint.hidden = false;
    mensajeHint.textContent = config.messageHint;
  });

  mensajeTextarea.addEventListener('input', () => {
    charCounter.textContent = `${mensajeTextarea.value.length} / ${MAX_MESSAGE_LENGTH}`;
  });

  function showStatus(kind, title, subtitle) {
    formStatus.hidden = false;
    formStatus.className = `form-status ${kind}`;
    formStatus.replaceChildren();
    const titleEl = document.createElement('p');
    titleEl.className = 'status-title';
    titleEl.textContent = title;
    const subtitleEl = document.createElement('p');
    subtitleEl.className = 'status-subtitle';
    subtitleEl.textContent = subtitle;
    formStatus.append(titleEl, subtitleEl);
  }

  /** The API answers with a machine-readable `code`; the copy lives here. */
  function messageForCode(code) {
    const template = i18n.errors[code] ?? i18n.errors.UNKNOWN;
    return fmt(template, { max: MAX_MESSAGE_LENGTH });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!validateClientSide()) return;

    submitBtn.disabled = true;
    submitBtn.textContent = i18n.submitting;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: nombreInput.value.trim(),
          email: emailInput.value.trim(),
          tipo: tipoSelect.value,
          empresa: empresaInput.value.trim(),
          mensaje: mensajeTextarea.value.trim(),
          lang,
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        showStatus('error', i18n.status.errorTitle, messageForCode(data.code));
        return;
      }

      showStatus('success', i18n.status.successTitle, i18n.status.successSubtitle);
      form.reset();
      charCounter.textContent = `0 / ${MAX_MESSAGE_LENGTH}`;
      empresaField.hidden = true;
      mensajeHint.hidden = true;
    } catch {
      showStatus('error', i18n.status.errorTitle, i18n.status.networkError);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = i18n.submit;
    }
  });
</script>
