---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
  <div class="left">
    <span>© {year} Carlos Volweides. {t.footer.rights}</span>
  </div>
</footer>
